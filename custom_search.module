<?php

/**
 * @file
 * Custom Search (inpramed-style) — hooks.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function custom_search_theme($existing, $type, $theme, $path): array {
  return [
    'custom_search_block' => [
      'variables' => [
        'placeholder' => NULL,
        'suggest_url' => NULL,
        'results_url' => NULL,
        'min_length' => 2,
      ],
      'template' => 'custom-search-block',
    ],
    'custom_search_results_form' => [
      'variables' => [
        'q' => '',
        'placeholder' => NULL,
      ],
      'template' => 'custom-search-results-form',
    ],
    'custom_search_results_list' => [
      'variables' => ['items' => []],
      'template' => 'custom-search-results-list',
    ],
  ];
}

/**
 * Implements hook_help().
 */
function custom_search_help($route_name, $route_match): ?string {
  switch ($route_name) {
    case 'help.page.custom_search':
      return '<p>' . t('Footer live search like on inpramed.ru: suggestions while typing, Enter opens the results page at /custom-search?q=…. Place the “Custom Search” block in the footer via Structure → Block layout.') . '</p>';

    case 'custom_search.settings':
      return '<p>' . t('Configure placeholder, limits, content types. Descriptions in Russian and English are located in separate tabs below.') . '</p>';
  }
  return NULL;
}
