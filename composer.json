{
  "name": "mmitekk/drupal-custom-search",
  "description": "Custom Search for Drupal 10 — footer search with live suggestions (like inpramed.ru) and a full results page. Enter opens the results page.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "keywords": ["drupal", "search", "autocomplete", "custom-search"],
  "require": {
    "php": ">=8.1",
    "drupal/core": "^10 || ^11"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "installer-name": "custom_search",
    "drupal": {
      "machine-name": "custom_search"
    },
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "support": {
    "issues": "https://github.com/Mmitekk/drupal-custom-search/issues",
    "source": "https://github.com/Mmitekk/drupal-custom-search"
  },
  "authors": [
    {
      "name": "Mmitekk",
      "homepage": "https://github.com/Mmitekk/drupal-custom-search"
    }
  ]
}
